APP_NAME=Fitnix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gymai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Super Admin account created by `php artisan db:seed` (skipped while the password is empty).
SUPER_ADMIN_NAME="Platform Admin"
SUPER_ADMIN_EMAIL=admin@gymai.com
SUPER_ADMIN_PASSWORD=

# Member app OTPs. "log" writes the SMS to storage/logs/laravel.log (local only).
# OTP_EXPOSE_IN_RESPONSE=true also returns the code in the API response; never in production.
SMS_DRIVER=log
# Real SMS: SMS_DRIVER=smartping and the account below (from the manager, never committed).
SMARTPING_USERNAME=
SMARTPING_PASSWORD=
SMARTPING_SENDER=PAMFIN
OTP_EXPOSE_IN_RESPONSE=false
# Member API token lifetime in minutes; empty means tokens never expire.
SANCTUM_EXPIRATION=

APP_TIMEZONE=Asia/Kolkata

# Push notifications (Firebase Cloud Messaging): service-account JSON (Firebase -> Project settings -> Service accounts)
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# AI progress module (https://openrouter.ai/keys). Without a key, AI reports fail and use no credits.
# Optional: the Super Admin can also save the key on Platform -> AI Coach, which then replaces this one.
OPENROUTER_API_KEY=
